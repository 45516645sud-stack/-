# 이 파일은 "어떤 값이 필요한지"만 보여주는 예시입니다 — 실제 키는 절대 여기에 넣지 마세요.
# 진짜 값은 같은 폴더에 .env.local 이라는 파일을 새로 만들어서 넣으세요.
# (.env.local은 .gitignore에 등록되어 있어 git에 올라가지 않습니다.)

# Project Settings > API Keys 에서 "secret" 또는 "service_role" 키
# — RLS를 무시하는 강력한 권한이라 시드 스크립트(관리자 작업)에만 쓴다.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings > API Keys 에서 URL
SUPABASE_URL=https://hzomhheyccapnzuwtzxh.supabase.co

# GCP 콘솔 > API 및 서비스 > 사용자 인증 정보에서 발급받은 Vision API 키
# (로컬 테스트용. 실제 배포 시엔 `supabase secrets set`으로 등록)
GOOGLE_VISION_API_KEY=

# 공공데이터포털에서 발급받은 식약처 낱알식별정보 서비스키
MFDS_API_KEY=
