rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 수거함 위치는 앱의 모든 사용자가 읽을 수 있어야 하는 공개 정보.
    // 쓰기는 seed_collection_boxes 스크립트(Admin SDK, 규칙을 우회함)로만 수행하고
    // 클라이언트에서의 직접 쓰기는 막는다.
    match /collection_boxes/{boxId} {
      allow read: if true;
      allow write: if false;
    }

    // 그 외 컬렉션은 아직 앱에서 쓰지 않으므로 기본적으로 모두 차단한다.
    // 새 컬렉션(예: 사용자별 촬영 기록)을 추가할 때는 여기에 전용 규칙을 만들 것.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
